# Copy to .env and fill in. .env is gitignored.

# --- Core API ---
DATABASE_URL=postgres://user:pass@host:5432/bestbefore
NODE_ENV=development
PORT=4000
JWT_SECRET=change-me

# Admin + staff API keys (sent as x-admin-key / x-staff-key headers)
ADMIN_API_KEY=change-me-admin
STAFF_API_KEY=change-me-staff

# --- WooCommerce catalogue sync (sync.js) ---
WC_STORE_URL=https://www.best-before.co.za
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# --- upload-prices.js (scraper → /admin/competitor-prices/upload) ---
# API to POST the merged price CSV to (defaults to the Render URL if unset)
PRICE_UPLOAD_API_URL=https://best-before-backend.onrender.com
# Where the scrapers write their output/*.csv (defaults to ~/Desktop/Scrapers)
SCRAPERS_DIR=/Users/you/Desktop/Scrapers

# --- match-prices.js (PnP name → barcode, runs before upload-prices) ---
# Reads the catalogue from DATABASE_URL above. Needs the Render *external*
# connection string when run from a laptop (the weekly launchd job).
# Minimum fuzzy-match score to accept (default 0.55)
MATCH_THRESHOLD=0.55
# Override the PnP scraper output folder (defaults to
# ~/Desktop/Scrapers/PnP Scraper Tool/output)
# PNP_OUTPUT_DIR=/Users/you/Desktop/Scrapers/PnP Scraper Tool/output
